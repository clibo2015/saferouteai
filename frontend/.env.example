# SafeRouteAI Frontend Environment Variables
# Copy this file to .env.local and update the values

# API Configuration
REACT_APP_API_URL=https://your-render-service.onrender.com
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG_LOGS=true
REACT_APP_ENABLE_OFFLINE_MODE=true

# Map Configuration
REACT_APP_DEFAULT_CENTER_LAT=-33.9321
REACT_APP_DEFAULT_CENTER_LNG=18.8602
REACT_APP_DEFAULT_ZOOM=13

# Performance Settings
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_CACHE_TIMEOUT=300000

# Security Settings
REACT_APP_ENABLE_CSP=true
REACT_APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000