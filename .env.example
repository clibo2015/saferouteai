# SafeRouteAI Configuration
# Copy this file to .env and fill in your actual values

# Huawei Cloud Credentials (Required for Production)
# Get these from your Huawei Cloud Console -> My Credentials -> Access Keys
HUAWEI_CLOUD_AK=your_access_key_here
HUAWEI_CLOUD_SK=your_secret_key_here
HUAWEI_CLOUD_PROJECT_ID=your_project_id_here
HUAWEI_CLOUD_REGION=af-south-1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Demo Mode (set to false for production with real Huawei Cloud)
DEMO_MODE=true

# OBS Configuration
OBS_BUCKET_NAME=saferoute-ai-data

# ModelArts Configuration
MODELARTS_TRAINING_IMAGE=swr.af-south-1.myhuaweicloud.com/your-namespace/saferoute-training:latest
MODELARTS_INFERENCE_IMAGE=swr.af-south-1.myhuaweicloud.com/your-namespace/saferoute-inference:latest

# Competition Settings
COMPETITION_MODE=true
REAL_DATA_INTEGRATION=true

# Instructions for $100 Coupon Setup:
# 1. Copy this file to .env: cp .env.example .env
# 2. Sign up at https://console.huaweicloud.com (select af-south-1 region)
# 3. Apply your $100 coupon in Billing & Costs → Coupons
# 4. Get credentials from My Credentials → Access Keys
# 5. Replace the placeholder values above with your actual credentials
# 6. Set DEMO_MODE=false for production deployment
# 7. Run: python test_connection.py to verify connection
# 8. Monitor costs at https://console.huaweicloud.com/billing

# Cost Optimization Tips:
# - Start with CPU instances (cheaper than GPU)
# - Use STANDARD storage class for OBS
# - Enable auto-scaling to control costs
# - Monitor daily spending in the console