# SafeRouteAI backend configuration (Huawei-free field test)
# Copy to .env and fill in the values. Never commit the real .env.
#
# No HUAWEI_* variables are read or required.

# --- Neon PostgreSQL -------------------------------------------------------
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Authentication --------------------------------------------------------
# Use a long random value, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Runtime ---------------------------------------------------------------
# false = live field-test mode (no mock responses)
DEMO_MODE=false
API_HOST=0.0.0.0
API_PORT=8000

# --- Open-source maps ------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_TIMEOUT_SECONDS=15
NOMINATIM_TIMEOUT_SECONDS=10
MAP_USER_AGENT=SafeRouteAI/1.0 (field-test; Stellenbosch)

# --- Map defaults (Stellenbosch) -------------------------------------------
MAP_CENTER_LAT=-33.9321
MAP_CENTER_LNG=18.8602
MAP_DEFAULT_ZOOM=13

# --- Optional --------------------------------------------------------------
ESKOM_SE_PUSH_KEY=

# --- Render ----------------------------------------------------------------
# Set PYTHON_VERSION in the Render dashboard, e.g. 3.11.9
